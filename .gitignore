# Foundry
contracts/out/
contracts/cache/
# Foundry nests broadcast artifacts as <script>/<chainId>/, so a single `*` misses the
# dry-run directory and simulations get committed alongside real deployments.
contracts/broadcast/*/*/dry-run/
docs/book/

